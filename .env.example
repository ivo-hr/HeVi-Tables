# Public values from Supabase > Project settings > API.
# `npm run dev:local` injects local values automatically and does not need this
# file. Fill these values when using a hosted Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical public URL. Use http://localhost:3000 while developing locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public half of the VAPID key pair used for browser Push subscriptions.
# Generate the pair with `npm run push:keys`; the private half is an Edge
# Function secret and must never be prefixed with NEXT_PUBLIC_ or committed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-your-public-vapid-key

# Required in production by GET /api/health. Send it as:
# Authorization: Bearer <value>
HEALTHCHECK_SECRET=replace-with-a-long-random-value
